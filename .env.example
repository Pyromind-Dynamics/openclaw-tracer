# Docker Hub 用户名
DOCKER_USERNAME=your-dockerhub-username

# 镜像版本（默认从 pyproject.toml 读取）
VERSION=v0.1.0

# 容器内服务端口
PORT=43886

# 主机映射端口
HOST_PORT=43886

# 单批自动封批阈值（凑满即 flush→ready→立刻 advance→trigger）。
# Producer-only：agent 只写 span，不 seal；运维可用 POST /admin/flush seal_batch。
BUFFER_SIZE=8000

# 分片时间窗口（分钟）
TIME_WINDOW_MINUTES=30

# ---------- 鉴权 ----------
# 客户端推理鉴权（必填）
PROXY_API_KEY=your-proxy-api-key

# 上游模型服务密钥（写入 deployment litellm_params.api_key）
ACCESS_KEY=

# Admin 路由鉴权（仅 /admin/routing/**；未设置则 admin API 返回 503）
# 与 PROXY_API_KEY / ACCESS_KEY 互不通用
ADMIN_API_KEY=

# ---------- 热切流 / 路由持久化与回调（可选）----------
# ROUTING_STATE_PATH=/app/data/routing_state.json
# ROUTING_DRAIN_TIMEOUT_SECONDS=120
# ROUTING_CHANGE_CALLBACK_URL=https://hooks.example.com/routing
# ROUTING_CHANGE_CALLBACK_TIMEOUT=5
# ROUTING_CHANGE_CALLBACK_SCRIPT=/app/scripts/on_routing_change.sh
# ROUTING_CHANGE_CALLBACK_SCRIPT_TIMEOUT=30

# ---------- 训练 buffer / 双槽流水线（tracer 自动封批）----------
# TRAJECTORY_BUFFER_SIZE = 3×BUFFER_SIZE → 约三槽；GET /status 暴露 capacity/held。
# 运维旁路：POST /admin/flush {"seal_batch":true,"trigger_workflow":true}
TRAJECTORY_BUFFER_SIZE=24000
ENABLE_WORKFLOW_TRIGGER=1
# WORKFLOW_TRIGGER_SCRIPT=/app/scripts/trigger_orch_round.sh
# 训完后 orch 调 POST /admin/batches/{id}/release （ADMIN_API_KEY）删槽
# DATA_DELETE_CALLBACK_URL=https://hooks.example.com/data-deleted
# DATA_DELETE_CALLBACK_TIMEOUT=5
# DATA_DELETE_CALLBACK_SCRIPT=/app/scripts/on_data_delete.sh
# DATA_DELETE_CALLBACK_SCRIPT_TIMEOUT=30

# ---------- 上游 LLM 出站 HTTP(S) 代理（可选）----------
# 方式一：标准变量（shell 与多数工具通用）
# http_proxy=http://192.168.112.67:7897
# https_proxy=http://192.168.112.67:7897
# no_proxy=localhost,127.0.0.1

# 方式二：仅写入 .env、与其它程序隔离（未设置上面的标准变量时生效）
# OPENCLAW_HTTP_PROXY=http://192.168.112.67:7897
# OPENCLAW_HTTPS_PROXY=http://192.168.112.67:7897
# OPENCLAW_NO_PROXY=localhost,127.0.0.1
